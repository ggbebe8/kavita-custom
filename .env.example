# ==========================================
# Kavita Custom - Environment Configuration
# ==========================================

# Path to your books directory (where your EPUB/CBZ files are stored)
# Default: ~/kavita/books (automatically expands to your home directory)
BOOKS_PATH=~/kavita/books

# Path to Kavita config & database directory
# Default: ~/kavita/config (automatically expands to your home directory)
CONFIG_PATH=~/kavita/config

# Host port to access Kavita (default: 5000 -> http://localhost:5000)
PORT=5000

# Timezone
TZ=Asia/Seoul

# Server Edge-TTS Settings
TTS_THREADS=2
TTS_CACHE_MB=512
